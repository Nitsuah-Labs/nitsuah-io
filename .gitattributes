# Normalize line endings across platforms
* text=auto

# Ensure scripts use LF
*.sh text eol=lf
*.bash text eol=lf

# Source files: enforce LF
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf

# Read by `cat .nvmrc` in config/Dockerfile.* and the husky hooks; a CRLF
# checkout on Windows makes the Node-version check compare "26.x.y\r"
.nvmrc text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.webp binary
