# Pinned to the same exact Node version as .nvmrc, CI (setup-node reads .nvmrc),
# Netlify, the dev compose file and the husky hooks - enforced by
# `npm run check:node-lockstep` so the whole stack moves together.
FROM node:26.10.0-slim

# Set working directory
WORKDIR /app

# Copy package files first for better layer caching
COPY package.json package-lock.json ./

# Install all dependencies
RUN npm ci --legacy-peer-deps --prefer-offline

# Copy project files
COPY . .

# Fail the image build if the running Node isn't the one .nvmrc pins
RUN test "$(node -v)" = "v$(cat .nvmrc)" || { echo "Node $(node -v) != .nvmrc $(cat .nvmrc)"; exit 1; }

# Build for production (skip wagmi codegen for test env)
RUN npm run build:skip-wagmi

# Set environment variables for tests
ENV CI=true
ENV NODE_ENV=test
ENV NEXT_PUBLIC_TEST_HELPERS=1

# Expose port for production server (if needed)
EXPOSE 3000

# Default command runs all Jest unit/integration tests
CMD ["npm", "test"]
